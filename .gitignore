# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Beads issue tracker (Dolt-backed local DB; sync via Dolt, not git).
# Tracked exceptions: connection metadata + scaffolding are portable repo
# config; activity logs and jsonl exports are machine-local state.
.beads/*
!.beads/.gitignore
!.beads/README.md
!.beads/config.yaml
!.beads/metadata.json
!.beads/hooks/

# Transitory scratch artifacts (reviews, notes) — not canonical
scratch/

# Agent worktrees (implementation + review snapshots), ignored once here so
# creating one never edits this tracked file.
.worktrees/

# bd lock file written at the repo root
.beads.gate.lock

# bv (beads viewer) local config and caches
.bv/

# codex runtime state DBs
.codex/*.sqlite
.codex/*.sqlite-shm
.codex/*.sqlite-wal
!.beads/PRIME.md

# Optional product-owned HUD skill source (local checkout path only).
/.tze-hud-repo
/.tze-hud-repo.*
